---
import responsiveImages from "../../_data/responsive-images.json";

interface Variant {
  src: string;
  width: number;
}

interface ManifestEntry {
  width: number;
  height: number;
  sources: {
    avif: Variant[];
    webp: Variant[];
  };
}

export interface Props {
  src: string;
  alt: string;
  sizes?: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  decoding?: "async" | "auto" | "sync";
  class?: string;
}

const {
  src,
  alt,
  sizes = "100vw",
  width,
  height,
  loading = "lazy",
  decoding = "async",
  class: className,
} = Astro.props;
const manifest = responsiveImages as Record<string, ManifestEntry>;
const image = manifest[src];
const renderedWidth = width ?? image?.width;
const renderedHeight = height ?? image?.height;
const avifSrcset = image?.sources.avif
  .map((variant) => `${variant.src} ${variant.width}w`)
  .join(", ");
const webpSrcset = image?.sources.webp
  .map((variant) => `${variant.src} ${variant.width}w`)
  .join(", ");
---

<div
  class:list={["responsive-image bg-neutral-400", className]}
  data-responsive-image
  style={renderedWidth && renderedHeight
    ? `aspect-ratio: ${renderedWidth} / ${renderedHeight}`
    : undefined}
>
  <picture class="block h-full w-full">
    {avifSrcset && <source type="image/avif" srcset={avifSrcset} sizes={sizes} />}
    {webpSrcset && <source type="image/webp" srcset={webpSrcset} sizes={sizes} />}
    <img
      src={src}
      alt={alt}
      width={renderedWidth}
      height={renderedHeight}
      sizes={sizes}
      loading={loading}
      decoding={decoding}
      class={className}
    />
  </picture>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-responsive-image]").forEach((container) => {
    const image = container.querySelector("img");
    const clearPlaceholder = () => container.classList.remove("bg-neutral-400");

    if (image?.complete) {
      clearPlaceholder();
    } else {
      image?.addEventListener("load", clearPlaceholder, { once: true });
    }
  });
</script>
