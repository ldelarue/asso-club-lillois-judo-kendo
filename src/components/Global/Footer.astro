---
import conf from "../../utils/siteConfig";

// Footer navigation groups populated from config
const footerNavs = [
  {
    title: "Sites web affiliés",
    items: conf.footer["other-websites"].map((w) => ({
      text: w.label,
      href: w.url,
    })),
  },
  {
    title: "Liens utiles",
    items: conf.footer.links.map((l) => ({
      text: l.label.trim(),
      href: l.url,
    })),
  },
];

// Social media links from config
const socialLinks = [
  {
    name: "Facebook",
    href: conf.footer["facebook-link"],
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
];

// Current year for copyright
const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-neutral-400 pb-8">
  <div class="container">
    <div
      class="grid gap-y-8 md:grid-cols-2 md:gap-8 lg:grid-cols-3 lg:gap-32 mb-12 pt-8"
    >
      <!-- Contact Info -->
      <address class="not-italic">
        <h2 class="mb-4 text-lg font-bold text-neutral-400">Adresses</h2>
        <p class="ml-2">Dojo : {conf.footer.addresses.dojo}</p>
      </address>

      <!-- Navigation Links -->
      {
        footerNavs.map((group, index) => (
          <nav aria-labelledby={`footer-nav-${index}`}>
            <h2 id={`footer-nav-${index}`} class="mb-4 text-lg font-bold text-neutral-400">{group.title}</h2>
            <ul class="space-y-1 ml-2">
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:text-primary-300 transition-colors"
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <!-- Copyright -->
  <div class="pt-8 border-t border-[#2c2c28] text-center text-sm">
    <!-- Social Links -->
    <div class="flex space-x-8 mb-6 justify-center">
      {
        socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-white transition-colors"
            aria-label={link.name}
          >
            <Fragment set:html={link.icon} />
          </a>
        ))
      }
    </div>
    <p>&copy; {currentYear} Club Lillois de Judo Kendo. Tous droits réservés.</p>
    <a
      href="/mentions-legales"
      class="mt-3 inline-block text-sm hover:text-primary-300 transition-colors"
    >
      Mentions légales
    </a>
  </div>
</footer>
