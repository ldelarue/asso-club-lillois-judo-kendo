---
const navItems = [
  { text: "Accueil", href: "/" },
  { text: "Le Dojo", href: "/dojo" },
  { text: "Inscriptions", href: "/inscriptions" },
  { text: "Évènements", href: "/evenements" },
  { text: "Articles", href: "/articles" },
  { text: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<nav class="hidden lg:block" aria-label="Navigation principale">
  <ul class="flex items-center gap-6">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "text-base font-medium transition-colors hover:text-primary-600",
              isActive(item.href) ? "text-primary-600" : "text-gray-700",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<button
  id="mobile-menu-button"
  class="p-2 text-gray-700 transition-colors hover:text-primary-600 lg:hidden"
  aria-label="Ouvrir le menu"
  aria-controls="mobile-menu"
  aria-expanded="false"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="h-6 w-6"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M4 6h16M4 12h16M4 18h16"></path>
  </svg>
</button>

<nav
  id="mobile-menu"
  class="absolute inset-x-0 top-full hidden border-t border-gray-100 bg-white p-4 shadow-lg lg:hidden"
  aria-label="Navigation mobile"
>
  <ul class="grid grid-cols-2 gap-3">
    {
      navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              "block rounded-md border px-4 py-3 text-center text-sm font-medium",
              isActive(item.href)
                ? "border-primary-200 bg-primary-50 text-primary-600"
                : "border-transparent text-gray-700 hover:bg-gray-50",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-button",
  );
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  const closeMenu = (restoreFocus = false) => {
    menu?.classList.add("hidden");
    button?.setAttribute("aria-expanded", "false");
    button?.setAttribute("aria-label", "Ouvrir le menu");
    if (restoreFocus) button?.focus();
  };

  button?.addEventListener("click", (event) => {
    event.stopPropagation();
    const willOpen = menu?.classList.contains("hidden") ?? false;
    menu?.classList.toggle("hidden", !willOpen);
    button.setAttribute("aria-expanded", String(willOpen));
    button.setAttribute(
      "aria-label",
      willOpen ? "Fermer le menu" : "Ouvrir le menu",
    );
    if (willOpen) menu?.querySelector<HTMLAnchorElement>("a")?.focus();
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node)) return;
    if (!menu?.contains(event.target) && !button?.contains(event.target))
      closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !menu?.classList.contains("hidden")) {
      closeMenu(true);
      return;
    }

    if (event.key !== "Tab" || menu?.classList.contains("hidden")) return;

    const focusable = [
      button,
      ...Array.from(menu?.querySelectorAll<HTMLAnchorElement>("a") ?? []),
    ].filter(
      (element): element is HTMLButtonElement | HTMLAnchorElement =>
        element !== null,
    );
    const first = focusable[0];
    const last = focusable.at(-1);

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
</script>
