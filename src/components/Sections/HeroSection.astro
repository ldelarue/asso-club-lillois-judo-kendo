---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Button from "../UI/Button.astro";
import defaultBackgroundImage from "../../assets/images/montagne.webp";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: ImageMetadata;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Les escrimes japonaises",
  subtitle = "Une passion qui nous unit",
  backgroundImage = defaultBackgroundImage,
  ctaText = "Découvrir le dojo",
  ctaLink = "/dojo",
  secondaryCtaText = "Explorer nos disciplines",
  secondaryCtaLink = "/disciplines",
} = Astro.props;
---

<section class="relative flex min-h-[70vh] items-center overflow-hidden bg-neutral-400 pt-30">
  <div class="absolute inset-0 bg-neutral-400" data-hero-image>
    <Picture
      src={backgroundImage}
      alt=""
      widths={[640, 960, 1280, 1600, 2400]}
      sizes="100vw"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-full w-full object-cover object-[center_20%]"
    />
  </div>
  <div class="absolute inset-0 bg-black/60"></div>

  <div class="container relative">
    <div class="max-w-3xl text-white">
      <h1 class="text-4xl md:text-6xl font-bold mb-4 text-white">{title}</h1>
      <p class="text-xl md:text-2xl mb-8">{subtitle}</p>

      <div class="flex flex-wrap gap-4">
        <Button href={ctaLink} variant="primary" size="lg">
          {ctaText}
        </Button>

        <Button
          href={secondaryCtaLink}
          variant="outline"
          size="lg"
          class="bg-white/10 text-white border-white hover:bg-white hover:text-gray-900 backdrop-blur-sm"
        >
          {secondaryCtaText}
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-hero-image]").forEach((container) => {
    const image = container.querySelector("img");

    if (!image || image.complete) return;

    image.classList.add("hero-image-loading");
    image.addEventListener(
      "load",
      () => image.classList.remove("hero-image-loading"),
      { once: true },
    );
    image.addEventListener(
      "error",
      () => image.classList.remove("hero-image-loading"),
      { once: true },
    );
  });
</script>

<style>
  :global([data-hero-image] img) {
    transition: opacity 700ms ease-out;
  }

  :global([data-hero-image] img.hero-image-loading) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-hero-image] img) {
      transition: none;
    }
  }
</style>
