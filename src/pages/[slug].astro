---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/UI/Button.astro";
import ResponsiveImage from "../components/UI/ResponsiveImage.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import defaultProfile from "../assets/default-profile.png";

export async function getStaticPaths() {
  try {
    const disciplineEntries = await getCollection("disciplines", ({ data }) => {
      return import.meta.env.PROD ? !data.draft : true;
    });

    return disciplineEntries.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    }));
  } catch (error) {
    return [];
  }
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const allStaff = await getCollection("staff", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const staffByName = new Map(allStaff.map((staff) => [staff.data.name, staff]));
const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const formatDescription = (value: string | undefined) => {
  const text = value?.trim();
  if (!text) return undefined;

  const looksLikeHtml = /<\s*[a-z][^>]*>/i.test(text);
  if (looksLikeHtml) return text;

  return escapeHtml(text).replaceAll("\n", "<br />");
};

const getStaffDescription = (staff: CollectionEntry<"staff"> | undefined) => {
  const bio = formatDescription(staff?.data.bio);
  if (bio) return bio;
  return undefined;
};

const toStaffCard = (name: string) => {
  const staff = staffByName.get(name);
  return {
    name,
    image: staff?.data.image || defaultProfile.src,
    description: getStaffDescription(staff),
  };
};

// Coordinator appears first if they're also listed as a référent
const referentsRaw = entry.data.enseignantsReferents ?? [];
const coordinator = entry.data.coordinator;
const referents = (coordinator && referentsRaw.includes(coordinator)
  ? [coordinator, ...referentsRaw.filter((n) => n !== coordinator)]
  : referentsRaw
).map(toStaffCard);
const assistants = (entry.data.enseignantsAssistants ?? []).map(toStaffCard);

const socialLinks = [
  {
    name: "Facebook",
    href: entry.data.facebookLink,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.533 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    name: "Instagram",
    href: entry.data.instagramLink,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`,
  },
  {
    name: "YouTube",
    href: entry.data.youtubeLink,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
  {
    name: "Site web",
    href: entry.data.websiteLink,
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 010 20M12 2a15.3 15.3 0 000 20"/></svg>`,
  },
].filter((link) => Boolean(link.href));
---

<BaseLayout
  title={`${entry.data.name} - Nos disciplines`}
  description={entry.data.summary}
  image={entry.data.logo
    ? { url: entry.data.logo, alt: entry.data.name }
    : undefined}
>
  <section class="py-16 bg-paper">
    <div class="container">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-3">
        <div
          class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900 bg-white rounded-lg shadow-sm p-6 md:p-8 lg:p-10 lg:col-span-2"
        >
          <h1 class="text-3xl font-bold mb-4">{entry.data.name}</h1>
          <Content />
        </div>

        <aside class="sticky top-24 self-start rounded-lg bg-white p-6 shadow-sm">
            {
              entry.data.logo && (
                <div class="mb-6 flex min-h-48 justify-center overflow-hidden">
                  <ResponsiveImage
                    src={entry.data.logo}
                    alt={entry.data.name}
                    width={640}
                    height={400}
                    loading="lazy"
                    decoding="async"
                    class="h-48 w-full object-contain"
                  />
                </div>
              )
            }

            <div class="space-y-4 mb-6">
              {
referents.length > 0 && (
                <section aria-labelledby="referents-heading">
                  <h4 id="referents-heading" class="font-bold text-gray-700">
                    {referents.length === 1
                      ? "Enseignant référent"
                      : "Enseignants référents"}
                  </h4>
                  <ul class="space-y-3 mt-2">
                    {referents.map((referent) => (
                      <li class="flex items-start gap-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 bg-neutral-400">
                          <ResponsiveImage
                            src={referent.image}
                            alt={`Photo de ${referent.name}`}
                            width={48}
                            height={48}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover object-center"
                          />
                        </div>
                        <div class="min-w-0">
                          <p class="font-medium">{referent.name}</p>
                          {referent.description && (
                            <div
                              class="text-sm text-gray-600 mt-1"
                              set:html={referent.description}
                            />
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              assistants.length > 0 && (
                <section aria-labelledby="assistants-heading">
                  <h4 id="assistants-heading" class="font-bold text-gray-700">
                    {assistants.length === 1
                      ? "Enseignant assistant"
                      : "Enseignants assistants"}
                  </h4>
                  <ul class="space-y-3 mt-2">
                    {assistants.map((assistant) => (
                      <li class="flex items-start gap-3">
                        <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0 bg-neutral-400">
                          <ResponsiveImage
                            src={assistant.image}
                            alt={`Photo de ${assistant.name}`}
                            width={48}
                            height={48}
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover object-center"
                          />
                        </div>
                        <div class="min-w-0">
                          <p class="font-medium">{assistant.name}</p>
                          {assistant.description && (
                            <div
                              class="text-sm text-gray-600 mt-1"
                              set:html={assistant.description}
                            />
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </section>
              )
              }

              {
                entry.data.contact && (
                  <section aria-labelledby="contact-heading">
                    <h4 id="contact-heading" class="font-bold text-gray-700">Contact</h4>
                    {entry.data.contact.includes("@") ? (
                      <a
                        href={`mailto:${entry.data.contact}`}
                        class="mt-1 inline-flex items-center gap-1 text-sm text-gray-700 hover:text-primary-600"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          />
                        </svg>
                        {entry.data.contact}
                      </a>
                    ) : (
                      <p>{entry.data.contact}</p>
                    )}
                  </section>
                )
              }

              {
                entry.data.schedule && (
                  <section aria-labelledby="schedule-heading">
                    <h4 id="schedule-heading" class="font-bold text-gray-700">Horaires</h4>
                    <p>{entry.data.schedule}</p>
                  </section>
                )
              }
            </div>

            {
              socialLinks.length > 0 && (
                <nav class="mb-6 flex items-center justify-center gap-4" aria-label="Liens de la discipline">
                    {socialLinks.map((link) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-gray-500 hover:text-primary-600 transition-colors"
                        aria-label={link.name}
                      >
                        <Fragment set:html={link.icon} />
                      </a>
                    ))}
                </nav>
              )
            }

            <div class="flex flex-col space-y-3">
              <Button href="/inscriptions" variant="primary">
                S'inscrire
              </Button>
            </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
