---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import PostLayout from "../../../../../layouts/PostLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  getArticlePath,
  getArticlePathParams,
} from "../../../../../utils/dateUtils";

export async function getStaticPaths() {
  const blogEntries = await getCollection("articles", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const seenPaths = new Set<string>();

  return blogEntries.map((entry) => {
    const params = getArticlePathParams(entry);
    const path = Object.values(params).join("/");

    if (seenPaths.has(path)) {
      throw new Error(`Duplicate dated article path: /articles/${path}`);
    }

    seenPaths.add(path);
    return { params, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content } = await entry.render();

let relatedPosts: CollectionEntry<"articles">[] = [];
const allPosts = await getCollection("articles", ({ data }) =>
  import.meta.env.PROD ? !data.draft : true,
);
const postTags = entry.data.tags || [];

if (postTags.length > 0) {
  relatedPosts = allPosts
    .filter(
      (post) =>
        post.slug !== entry.slug &&
        post.data.tags.some((tag) => postTags.includes(tag)),
    )
    .sort((a, b) => {
      const aMatchCount = a.data.tags.filter((tag) =>
        postTags.includes(tag),
      ).length;
      const bMatchCount = b.data.tags.filter((tag) =>
        postTags.includes(tag),
      ).length;
      return bMatchCount - aMatchCount;
    })
    .slice(0, 3);
}
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={typeof entry.data.image === "string"
    ? { url: entry.data.image, alt: entry.data.title ?? "" }
    : entry.data.image}
  type="article"
>
  <PostLayout
    title={entry.data.title}
    description={entry.data.description}
    image={typeof entry.data.image === "string"
      ? { url: entry.data.image, alt: entry.data.title ?? "" }
      : entry.data.image}
    date={entry.data.pubDate}
    author={entry.data.author}
    tags={entry.data.tags}
  >
    <article
      class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900 prose-a:text-primary-600 hover:prose-a:text-primary-700"
    >
      <Content />
    </article>

    <div class="mt-12 border-t border-gray-200 py-6">
      <h3 class="mb-4 text-lg font-bold">Partager cet article</h3>
      <div class="flex space-x-4">
        <a
          href={`https://facebook.com/sharer/sharer.php?u=${Astro.url}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 transition-colors hover:text-blue-600"
          aria-label="Partager sur Facebook"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
          </svg>
        </a>

        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${Astro.url}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 transition-colors hover:text-blue-400"
          aria-label="Partager sur X"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723 10.03 10.03 0 01-3.127 1.184 4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"></path>
          </svg>
        </a>

        <a
          href={`mailto:?subject=${encodeURIComponent(entry.data.title)}&body=${encodeURIComponent(`Cet article pourrait vous intéresser : ${Astro.url}`)}`}
          class="text-gray-600 transition-colors hover:text-red-500"
          aria-label="Partager par e-mail"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </a>
      </div>
    </div>

    {
      relatedPosts.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-6 text-2xl font-bold">Articles similaires</h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            {relatedPosts.map((post) => (
              <a
                href={getArticlePath(post)}
                class="block rounded-lg bg-gray-50 p-4 transition-colors hover:bg-gray-100"
              >
                <h3 class="mb-2 font-bold">{post.data.title}</h3>
                <p class="mb-2 text-sm text-gray-600">Par {post.data.author}</p>
                <p class="text-sm font-medium text-primary-600">Lire la suite →</p>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </PostLayout>
</BaseLayout>
