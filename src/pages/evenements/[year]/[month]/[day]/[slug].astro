---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import PostLayout from "../../../../../layouts/PostLayout.astro";
import Button from "../../../../../components/UI/Button.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  formatDate,
  getEventPathParams,
} from "../../../../../utils/dateUtils";

export async function getStaticPaths() {
  const eventEntries: CollectionEntry<"events">[] = (
    await getCollection("events")
  ).filter(({ data }) => (import.meta.env.PROD ? !data.draft : true));
  const seenPaths = new Set<string>();

  return eventEntries.map((entry) => {
    const params = getEventPathParams(entry);
    const path = Object.values(params).join("/");

    if (seenPaths.has(path)) {
      throw new Error(`Duplicate dated event path: /evenements/${path}`);
    }

    seenPaths.add(path);
    return { params, props: { entry } };
  });
}

const { entry } = Astro.props as { entry: CollectionEntry<"events"> };
const { Content } = await entry.render();
const eventDate = entry.data.startDate;
const formattedDate = formatDate(eventDate);
const formattedEndDate = entry.data.endDate
  ? formatDate(entry.data.endDate)
  : null;
const isFutureEvent = eventDate > new Date();
---

<BaseLayout
  title={`${entry.data.title} - Événement`}
  description={entry.data.summary}
  image={{ url: entry.data.image, alt: entry.data.title }}
  type="article"
>
  <PostLayout
    title={entry.data.title}
    description={entry.data.summary}
    image={{ url: entry.data.image, alt: entry.data.title }}
    tags={entry.data.tags}
    imageHeight="full"
  >
    <div class="mb-8 rounded-lg bg-gray-50 p-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <section aria-labelledby="event-dates">
          <h3 id="event-dates" class="m-0 text-lg font-bold">Dates</h3>
          <div class="mb-2 flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mr-2 mt-0.5 h-5 w-5 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            {
              formattedEndDate && formattedEndDate !== formattedDate ? (
                <p class="my-0">{formattedDate} - {formattedEndDate}</p>
              ) : (
                <p class="my-0">{formattedDate}</p>
              )
            }
          </div>
          {
            entry.data.time && (
              <div class="mt-2 flex items-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="mr-2 h-5 w-5 text-primary-600"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="my-0">{entry.data.time}</p>
              </div>
            )
          }
        </section>

        <section aria-labelledby="event-location">
          <h3 id="event-location" class="m-0 text-lg font-bold">Lieu</h3>
          <div class="flex items-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="mr-2 mt-0.5 h-5 w-5 text-primary-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <p class="my-0">{entry.data.location}</p>
          </div>
        </section>
      </div>
    </div>

    <article
      class="prose prose-lg max-w-none prose-headings:text-gray-900 prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-p:text-gray-700 prose-li:text-gray-700 prose-strong:text-gray-900 prose-a:text-primary-600 hover:prose-a:text-primary-700"
    >
      <Content />
    </article>

    <div class="mb-12 mt-12 flex flex-wrap justify-center gap-4">
      {
        isFutureEvent && entry.data.registrationLink && (
          <Button
            href={entry.data.registrationLink}
            variant="primary"
            class="!text-white no-underline hover:no-underline"
          >
            Accéder au formulaire d'inscription
          </Button>
        )
      }
    </div>
  </PostLayout>
</BaseLayout>
