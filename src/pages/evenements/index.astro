---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/UI/Card.astro";
import { getCollection } from "astro:content";
import {
  formatDate,
  getEventEndDate,
  getEventPath,
  isPastDate,
} from "../../utils/dateUtils";

// Get all events
const allEvents = await getCollection("events", ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

// Events without an explicit end date are single-day events.
const upcomingEvents = allEvents
  .filter((event) => !isPastDate(getEventEndDate(event.data)))
  .sort(
    (a, b) =>
      new Date(a.data.startDate).getTime() -
      new Date(b.data.startDate).getTime(),
  );
const pastEvents = allEvents
  .filter((event) => isPastDate(getEventEndDate(event.data)))
  .sort(
    (a, b) =>
      new Date(b.data.startDate).getTime() -
      new Date(a.data.startDate).getTime(),
  )
  .slice(0, 6); // Show only the most recent past events
---

<BaseLayout title="Évènements">
  <!-- Upcoming Events -->
  <section class="py-16 bg-paper">
    <div class="container">
      <h1 class="mb-12 text-center text-3xl font-bold md:text-4xl">À venir</h1>

      {
        upcomingEvents.length > 0 ? (
          <div class="flex flex-wrap justify-center gap-8">
            {upcomingEvents.map((event) => (
              <Card
                title={event.data.title}
                image={{
                  src: event.data.image,
                  alt: event.data.title,
                }}
                href={getEventPath(event)}
                className="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333333%-1.333333rem)]"
              >
                <div class="mb-3 flex items-center text-gray-600">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 mr-2"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    <time datetime={event.data.startDate.toISOString()}>
                      {formatDate(event.data.startDate)}
                      {event.data.endDate &&
                        ` - ${formatDate(event.data.endDate)}`}
                    </time>
                </div>
                {event.data.time && (
                  <div class="mb-3 flex items-center text-gray-600">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 mr-2"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    <span>{event.data.time}</span>
                  </div>
                )}

                <div class="mb-3 flex items-center text-gray-600">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 mr-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <span>{event.data.location}</span>
                </div>

                <p class="text-gray-700 mb-4">{event.data.summary}</p>

                <p class="text-primary-600 font-medium group-hover:underline group-hover:text-primary-700">
                  En savoir plus →
                </p>
              </Card>
            ))}
          </div>
        ) : (
          <p class="mx-auto max-w-md rounded-lg bg-white py-12 text-center text-gray-600 shadow-sm">
            Aucun évènement à venir.
          </p>
        )
      }
    </div>
  </section>

  <!-- Past Events -->
  <section class="py-16 bg-gray-50">
    <div class="container">
      <h2 class="mb-12 text-center text-3xl font-bold md:text-4xl">Passés</h2>

      {
        pastEvents.length > 0 ? (
          <div class="flex flex-wrap justify-center gap-8">
            {pastEvents.map((event) => (
              <Card
                title={event.data.title}
                image={{
                  src: event.data.image,
                  alt: event.data.title,
                }}
                href={getEventPath(event)}
                className="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333333%-1.333333rem)] opacity-90 hover:opacity-100"
              >
                <div class="mb-3 flex items-center text-gray-600">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-5 w-5 mr-2"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    <time datetime={event.data.startDate.toISOString()}>
                      {formatDate(event.data.startDate)}
                      {event.data.endDate &&
                        ` - ${formatDate(event.data.endDate)}`}
                    </time>
                </div>
                <div class="mb-3 flex items-center text-gray-600">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 mr-2"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  <span>{event.data.location}</span>
                </div>

                <p class="text-gray-700 mb-4">{event.data.summary}</p>

                <p class="text-primary-600 font-medium group-hover:underline group-hover:text-primary-700">
                  Consulter →
                </p>
              </Card>
            ))}
          </div>
        ) : (
          <p class="mx-auto max-w-md rounded-lg bg-white py-12 text-center text-gray-600 shadow-sm">
            Aucun évènement passé à afficher.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>
